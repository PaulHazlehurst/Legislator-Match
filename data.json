  "topics": {
    "workforce": {
      "label": "Workforce development",
      "subtopics": {
        "training-programs": "Training programs",
        "employer-incentives": "Employer incentives",
        "grants": "Workforce grants",
        "apprenticeships": "Apprenticeship programs",
        "youth-employment": "Youth employment"
      },
      "guidance": {
        "includes": "job training programs, apprenticeships, vocational and career education, employer hiring incentives specifically tied to employment, skills development grants, workforce development boards, youth employment programs, unemployment insurance reform, job placement services, registered apprenticeship programs, labor market programs, career readiness initiatives",
        "excludes": "veterans benefits programs (even if veterans are mentioned as a beneficiary population \u2014 classify by what the bill DOES), disability accommodations (classify as human services), general economic development or business incentives not tied to hiring, business licensing, wage theft (classify as labor-employment), minimum wage (classify as labor-employment)"
      }
    },
    "healthcare": {
      "label": "Healthcare access",
      "subtopics": {
        "insurance-coverage": "Insurance coverage",
        "hospital-funding": "Hospital funding",
        "access-equity": "Access & equity",
        "medicaid-medicare": "Medicaid & Medicare",
        "mental-health": "Mental health & substance abuse",
        "prescription-drugs": "Prescription drug policy",
        "public-health": "Public health programs"
      },
      "guidance": {
        "includes": "health insurance coverage mandates and regulations, Medicaid and Medicare policy, hospital funding and licensing, mental health and substance abuse treatment access, prescription drug pricing and access, telehealth policy, nursing home and assisted living standards, public health programs and disease prevention, health equity initiatives, patient rights and protections, healthcare workforce shortages, pharmacy regulations",
        "excludes": "workplace safety regulations not specific to healthcare settings, veterinary medicine, health-related tax credits that are primarily fiscal policy, general appropriations that incidentally fund health programs, long-term care financing that is primarily an insurance/financial product (classify as insurance)"
      }
    },
    "environment": {
      "label": "Environment / energy",
      "subtopics": {
        "clean-energy": "Clean energy",
        "conservation": "Conservation",
        "waste-pollution": "Waste & pollution",
        "chesapeake-bay": "Chesapeake Bay & waterways",
        "climate": "Climate policy",
        "ev-transportation": "Electric vehicles & green transportation"
      },
      "guidance": {
        "includes": "clean and renewable energy policy, solar and wind energy incentives, emissions standards and climate targets, conservation of land and natural resources, water quality and stormwater management, wildlife protection, pollution control (air, water, soil), recycling and waste reduction, forest preservation, bay and watershed restoration (especially Chesapeake Bay), electric vehicle incentives, environmental justice",
        "excludes": "agricultural policy that is primarily about farm economics or farming practices (classify as agriculture), transportation infrastructure that is primarily about roads/transit (classify as transportation) unless the bill is specifically about emissions or EV, mining and drilling bills that are primarily economic in nature"
      }
    },
    "education": {
      "label": "Education funding",
      "subtopics": {
        "k12-funding": "K-12 funding",
        "higher-ed-funding": "Higher ed funding",
        "teacher-support": "Teacher support",
        "school-choice": "School choice",
        "higher-ed": "Higher education",
        "early-childhood": "Early childhood education",
        "school-safety": "School safety",
        "special-ed": "Special education"
      },
      "guidance": {
        "includes": "K-12 school funding formulas and allocations (Blueprint for Maryland's Future), teacher pay certification and professional development, curriculum and testing standards, higher education tuition affordability and student aid, school construction and facilities, special education services, early childhood education and pre-K, school choice and charter schools, literacy and reading programs, school safety",
        "excludes": "workforce training programs that happen to take place in school settings (classify as workforce), student loan policy that is primarily a financial services regulation (classify as insurance-financial), general state appropriations that incidentally fund schools"
      }
    },
    "veterans": {
      "label": "Veterans affairs",
      "guidance": {
        "includes": "veteran-specific benefits and services, veterans' employment preferences and programs (distinct from general workforce), military service member protections, veteran housing assistance, veteran mental health programs, military pension and retirement benefits, National Guard policy, veteran licensing reciprocity, military family support, veteran cemeteries and memorials, veteran service organizations",
        "excludes": "general workforce development programs that happen to mention veterans as one of many populations served (classify as workforce), general healthcare programs that mention veterans (classify as healthcare unless exclusively for veterans), defense procurement (federal, not state)"
      },
